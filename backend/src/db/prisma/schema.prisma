// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String    @id @default(uuid())
  name        String 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  projects    Project[]

  @@map("organizations")
}


model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  role           String       @default("member") // admin | member | viewer
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("users")
}

model Project {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  apiKeys        ApiKey[]
  createdAt      DateTime     @default(now())

  @@map("projects")
}


model ApiKey {
  id        String   @id @default(uuid())
  keyHash   String   @unique
  keyPrefix String   
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@map("api_keys")
}


model AlertRule {
  id            String   @id @default(uuid())
  projectId     String
  metric        String   // "latency" | "cost" | "error_rate" | "request_volume"
  condition     String   // "gt" | "lt"
  threshold     Float
  channel       String   // "slack" | "email" | "webhook"
  channelTarget String   // webhook URL, email address, etc.
  createdAt     DateTime @default(now())

  @@map("alert_rules")
}

model HourlyMetric {
  id           String   @id @default(uuid())
  projectId    String
  hour         DateTime
  requestCount Int      @default(0)
  avgLatencyMs Float    @default(0)
  totalCostUsd Float    @default(0)
  errorRate    Float    @default(0)

  @@unique([projectId, hour])
  @@map("hourly_metrics")
}


